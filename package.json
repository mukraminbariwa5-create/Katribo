{
  "name": "katribo",
  "private": true,
  "version": "1.0.0",
  "description": "KATRIBO \u2014 Welcome to Our Backyard. Coffee shop website built with React, TypeScript, Vite and Tailwind CSS.",
  "type": "module",
  "author": "Mukramin Bariwa Ansao",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:server": "vite build && vite build --ssr shared/order.ts --outDir dist-server",
    "start": "node server.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:images": "node scripts/check-images.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
